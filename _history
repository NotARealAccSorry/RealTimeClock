e=\"false\"><mutation items=\"7\"></mutation><value name=\"ADD0\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"pI/$dM]9P/C[tuf(v{)+\">hours12</field></block></value><value name=\"ADD1\"><shadow type=\"text\"><field name=\"TEXT\">:</field></shadow></value><value name=\"ADD2\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"l:s|eA-OG:M]zR{G$`H`\">minuteString</field></block></value><value name=\"ADD3\"><shadow type=\"text\"><field name=\"TEXT\">:</field></shadow></value><value name=\"ADD4\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\":q+M)?b:fF%,n]3.AWT$\">secondString</field></block></value><value name=\"ADD5\"><shadow type=\"text\"><field name=\"TEXT\"> </field></shadow></value><value name=\"ADD6\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"TpUI.5{I_M{kHh7ZkVaD\">amPm</field></block></value></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type=\"gameinterval\" x=\"316\" y=\"1476\"><value name=\"period\"><shadow type=\"timePicker\"><field name=\"ms\">500</field></shadow></value><statement name=\"HANDLER\"><block type=\"game_show_long_text\"><field name=\"layout\">DialogLayout.Bottom</field><comment pinned=\"false\" h=\"80\" w=\"160\">Display the perfect time</comment><value name=\"str\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"%,^P{LaB#6U/+59[!rF^\">readableTime</field></block></value></block></statement></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":37,"diffs":[[1,"// Create a global variable to store the text format\nlet readableTime = \"00:00:00 AM\"\n\n// This loop runs automatically every single frame to calculate and draw the time\ngame.onUpdate(function () {\n    let timestamp = browserEvents.currentTime()\n\n    // 1. Safe 64-bit conversion math (prevents negative/broken numbers)\n    let totalSeconds = Math.floor(timestamp / 1000)\n    let totalMinutes = Math.floor(totalSeconds / 60)\n    let totalHours = Math.floor(totalMinutes / 60)\n\n    // 2. Adjust for your Timezone (-7 for Pacific Time, change to match your local area)\n    let timezoneOffset = -7\n    let localHours24 = (totalHours + timezoneOffset) % 24\n    if (localHours24 < 0) {\n        localHours24 += 24\n    }\n\n    // 3. Extract time components\n    let minutes = totalMinutes % 60\n    let seconds = totalSeconds % 60\n\n    let amPm = localHours24 >= 12 ? \"PM\" : \"AM\"\n    let hours12 = localHours24 % 12\n    if (hours12 == 0) {\n        hours12 = 12\n    }\n\n    // 4. Pad single digits with leading zeros\n    let minuteString = minutes < 10 ? \"0\" + minutes : \"\" + minutes\n    let secondString = seconds < 10 ? \"0\" + seconds : \"\" + seconds\n\n    // 5. Build the final clean string\n    readableTime = hours12 + \":\" + minuteString + \":\" + secondString + \" \" + amPm\n\n    // 6. Print directly to screen canvas: screen.print(text, x, y, color_id)\n    // x=2, y=2 places it in the top-left corner. color=1 prints it in white.\n    screen.print(readableTime, 2, 2, 1)\n})\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":209,"length1":43,"diffs":[[1,"        \"assets.json\"\n"]]},{"start1":238,"length1":35,"diffs":[[1,"    \"preferredEditor\": \"tsprj\"\n"]]}]},{"type":"added","filename":"custom.ts","value":"// Define the Time Unit Enum for the block dropdown menu\nenum TimeField {\n    //% block=\"Year\"\n    Year,\n    //% block=\"Month\"\n    Month,\n    //% block=\"Day of Week\"\n    DayOfWeek,\n    //% block=\"Hour\"\n    Hour,\n    //% block=\"Minute\"\n    Minute,\n    //% block=\"Second\"\n    Second\n}\n\n// Define the Timezone Enum for the block dropdown menu\nenum Timezone {\n    //% block=\"UTC / GMT\"\n    UTC = 0,\n    //% block=\"EST (Eastern Standard Time / UTC-5)\"\n    EST = -5,\n    //% block=\"CST (Central Standard Time / UTC-6)\"\n    CST = -6,\n    //% block=\"MST (Mountain Standard Time / UTC-7)\"\n    MST = -7,\n    //% block=\"PST (Pacific Standard Time / UTC-8)\"\n    PST = -8,\n    //% block=\"AKST (Alaska Standard Time / UTC-9)\"\n    AKST = -9,\n    //% block=\"HST (Hawaii Standard Time / UTC-10)\"\n    HST = -10,\n    //% block=\"CET (Central European Time / UTC+1)\"\n    CET = 1,\n    //% block=\"EET (Eastern European Time / UTC+2)\"\n    EET = 2,\n    //% block=\"AEST (Australian Eastern Time / UTC+10)\"\n    AEST = 10\n}\n\n//% color=\"#4b0082\" icon=\"\\uf017\" block=\"Real Clock\"\nnamespace realClock {\n    let savedTimezoneOffset = 0;\n\n    /**\n     * Sets the local timezone using a clean block dropdown selection.\n     * @param tz Choose your local named timezone\n     */\n    //% block=\"set local timezone to %tz\"\n    //% tz.defl=Timezone.UTC\n    export function setTimezone(tz: Timezone): void {\n        savedTimezoneOffset = tz;\n    }\n\n    /**\n     * Extracts a specific time unit as a number based on the saved timezone.\n     * @param field The specific unit you want to retrieve\n     */\n    //% block=\"get current %field\"\n    export function getTimeUnit(field: TimeField): number {\n        let timestamp = browserEvents.currentTime();\n        \n        let totalSeconds = Math.floor(timestamp / 1000);\n        let totalMinutes = Math.floor(totalSeconds / 60);\n        let totalHours = Math.floor(totalMinutes / 60);\n        let totalDays = Math.floor(totalHours / 24);\n\n        let localHours24 = (totalHours + savedTimezoneOffset) % 24;\n        if (localHours24 < 0) localHours24 += 24;\n\n        if (field === TimeField.Second) return totalSeconds % 60;\n        if (field === TimeField.Minute) return totalMinutes % 60;\n        if (field === TimeField.Hour) return localHours24;\n\n        let adjustedDays = totalDays + Math.floor((totalHours + savedTimezoneOffset) / 24) - totalDays;\n        let dayCounter = totalDays + adjustedDays;\n\n        if (field === TimeField.DayOfWeek) {\n            return (dayCounter + 4) % 7;\n        }\n\n        let year = 1970;\n        while (true) {\n            let daysInYear = (year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0)) ? 366 : 365;\n            if (dayCounter >= daysInYear) {\n                dayCounter -= daysInYear;\n                year++;\n            } else {\n                break;\n            }\n        }\n        if (field === TimeField.Year) return year;\n\n        let isLeap = (year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0));\n        let daysInMonths = [31, isLeap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n        let month = 1;\n        for (let i = 0; i < 12; i++) {\n            if (dayCounter >= daysInMonths[i]) {\n                dayCounter -= daysInMonths[i];\n                month++;\n            } else {\n                break;\n            }\n        }\n        if (field === TimeField.Month) return month;\n\n        return 0;\n    }\n\n    /**\n     * UTILITY: Checks if a specific time field equals a given value.\n     * @param field The field to check\n     * @param value The number to compare against\n     */\n    //% block=\"current %field equals %value\"\n    export function isTimeFieldEqual(field: TimeField, value: number): boolean {\n        return getTimeUnit(field) === value;\n    }\n\n    /**\n     * UTILITY: Returns true if it is currently PM, false if it is AM.\n     */\n    //% block=\"is current time PM\"\n    export function isPM(): boolean {\n        return getTimeUnit(TimeField.Hour) >= 12;\n    }\n\n    /**\n     * Returns a formatted time string (HH:MM:SS AM/PM) using your saved timezone.\n 