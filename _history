dTimezoneOffset = tz;\n    }\n\n    /**\n     * Prompts the player to select their local timezone from a scrolling menu list.\n     * Control with Up/Down D-pad buttons and press A to confirm.\n     */\n    //% block=\"ask player for timezone via menu\"\n    export function askPlayerForTimezoneMenu(): void {\n        if (isMenuOpen) return;\n        isMenuOpen = true;\n\n        let names = [\"UTC / GMT\", \"EST (Eastern)\", \"CST (Central)\", \"MST (Mountain)\", \"PST (Pacific)\", \"AKST (Alaska)\", \"HST (Hawaii)\", \"CET (Europe)\", \"EET (E. Europe)\", \"AEST (Australia)\"];\n        let offsets = [0, -5, -6, -7, -8, -9, -10, 1, 2, 10];\n        let selectedIndex = 0;\n\n        // Freeze game update operations while menu selection runs\n        game.pushScene();\n\n        // Control handlers for navigation\n        controller.up.onEvent(ControllerButtonEvent.Pressed, function() {\n            selectedIndex = (selectedIndex - 1 + names.length) % names.length;\n        });\n\n        controller.down.onEvent(ControllerButtonEvent.Pressed, function() {\n            selectedIndex = (selectedIndex + 1) % names.length;\n        });\n\n        controller.A.onEvent(ControllerButtonEvent.Pressed, function() {\n            savedTimezoneOffset = offsets[selectedIndex];\n            isMenuOpen = false;\n            game.popScene(); // Restore original game scene\n        });\n\n        // Render loop for the selection list interface\n        game.onPaint(function() {\n            screen.fill(15); // Clear window background to black\n            screen.print(\"SELECT YOUR TIMEZONE:\", 10, 8, 4);\n            screen.drawLine(10, 18, 150, 18, 4);\n\n            // Determine sliding window index range for visibility constraints\n            let startIdx = Math.max(0, selectedIndex - 2);\n            if (startIdx + 5 > names.length) startIdx = Math.max(0, names.length - 5);\n\n            for (let i = 0; i < 5; i++) {\n                let currentItem = startIdx + i;\n                if (currentItem >= names.length) break;\n\n                let yPos = 26 + (i * 14);\n                if (currentItem === selectedIndex) {\n                    screen.fillRect(6, yPos - 2, 148, 13, 5); // Draw selector highlight container\n                    screen.print(\"> \" + names[currentItem], 10, yPos, 1);\n                } else {\n                    screen.print(\"  \" + names[currentItem], 10, yPos, 9);\n                }\n            }\n            \n            screen.print(\"Press [A] to Confirm\", 20, 105, 7);\n        });\n\n        // Wait until menu closure flag updates\n        while (isMenuOpen) {\n            pause(20);\n        }\n    }\n\n    /**\n     * Extracts a specific time unit as a number based on the saved timezone.\n     * @param field The specific unit you want to retrieve\n     */\n    //% block=\"get current %field\"\n    export function getTimeUnit(field: TimeField): number {\n        let timestamp = browserEvents.currentTime();\n        \n        let totalSeconds = Math.floor(timestamp / 1000);\n        let totalMinutes = Math.floor(totalSeconds / 60);\n        let totalHours = Math.floor(totalMinutes / 60);\n        let totalDays = Math.floor(totalHours / 24);\n\n        let localHours24 = (totalHours + savedTimezoneOffset) % 24;\n        if (localHours24 < 0) localHours24 += 24;\n\n        if (field === TimeField.Second) return totalSeconds % 60;\n        if (field === TimeField.Minute) return totalMinutes % 60;\n        if (field === TimeField.Hour) return localHours24;\n\n        let adjustedDays = totalDays + Math.floor((totalHours + savedTimezoneOffset) / 24) - totalDays;\n        let dayCounter = totalDays + adjustedDays;\n\n        if (field === TimeField.DayOfWeek) {\n            return (dayCounter + 4) % 7;\n        }\n\n        let year = 1970;\n        while (true) {\n            let daysInYear = (year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0)) ? 366 : 365;\n            if (dayCounter >= daysInYear) {\n                dayCounter -= daysInYear;\n                year++;\n            } else {\n                break;\n            }\n        }\n        if (field === TimeField.Year) return year;\n\n        let isLeap = (year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0));\n        let daysInMonths = [31, isLeap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n        let month = 1;\n        for (let i = 0; i < 12; i++) {\n            if (dayCounter >= daysInMonths[i]) {\n                dayCounter -= daysInMonths[i];\n                month++;\n            } else {\n                break;\n            }\n        }\n        if (field === TimeField.Month) return month;\n\n        return 0;\n    }\n\n    /**\n     * Checks if a specific time field equals a given value.\n     * @param field The field to check\n     * @param value The number to compare against\n     */\n    //% block=\"current %field equals %value\"\n    export function isTimeFieldEqual(field: TimeField, value: number): boolean {\n        return getTimeUnit(field) === value;\n    }\n\n    /**\n     * Returns true if it is currently PM, false if it is AM.\n     */\n    //% block=\"is current time PM\"\n    export function isPM(): boolean {\n        return getTimeUnit(TimeField.Hour) >= 12;\n    }\n\n    /**\n     * Returns the text name of the current day of the week.\n     */\n    //% block=\"get day of week name string\"\n    export function getDayOfWeekName(): string {\n        let dayNum = getTimeUnit(TimeField.DayOfWeek);\n        let days = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"];\n        return days[dayNum];\n    }\n\n    /**\n     * Returns true if it's night time (between 7 PM and 6 AM).\n     */\n    //% block=\"is night time\"\n    export function isNightTime(): boolean {\n        let hr = getTimeUnit(TimeField.Hour);\n        return (hr >= 19 || hr < 6);\n    }\n\n    /**\n     * Returns true if the day is Saturday (6) or Sunday (0).\n     */\n    //% block=\"is weekend\"\n    export function isWeekend(): boolean {\n        let dayNum = getTimeUnit(TimeField.DayOfWeek);\n        return (dayNum === 0 || dayNum === 6);\n    }\n\n    /**\n     * Returns a formatted time string (HH:MM:SS AM/PM) using your saved timezone.\n     */\n    //% block=\"get formatted time string\"\n    export function getFormattedTime(): string {\n        let hour = getTimeUnit(TimeField.Hour);\n        let minute = getTimeUnit(TimeField.Minute);\n        let second = getTimeUnit(TimeField.Second);\n\n        let amPm = hour >= 12 ? \"PM\" : \"AM\";\n        let hours12 = hour % 12;\n        if (hours12 === 0) hours12 = 12;\n\n        let minuteString = minute < 10 ? \"0\" + minute : \"\" + minute;\n        let secondString = second < 10 ? \"0\" + second : \"\" + second;\n\n        return hours12 + \":\" + minuteString + \":\" + secondString + \" \" + amPm;\n    }\n}\n","pxt.json":"{\n    \"name\": \"Islander\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"browser-events\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"custom.ts\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1780896169920,"editorVersion":"4.0.14","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"realClock_askPlayerForTimezoneMenu\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"1\" _input_init=\"true\"></mutation><field name=\"confirmKey\">BrowserConfirmKey.Space</field></block></statement></block></xml>","main.ts":"realClock.askPlayerForTimezoneMenu(BrowserConfirmKey.Space)\n","README.md":" ","assets.json":"","custom.ts":" enum TimeField {\n    //% block=\"Year\"\n    Year,\n    //% block=\"Month\"\n    Month,\n    //% block=\"Day of Week