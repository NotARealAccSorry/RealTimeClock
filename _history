s();\n        }\n        return 0;\n    }\n\n    function initializeDayTrackers() {\n        let currentMs = currentTime();\n\n        \n        if (!settings.exists(\"first_play_date\")) {\n            settings.writeNumber(\"first_play_date\", currentMs);\n        }\n\n        let standardDayMs = 86400000;\n        let currentDayIdentifier = Math.floor(currentMs / standardDayMs);\n        \n        let lastPlayedDay = settings.readNumber(\"last_played_day\");\n        let totalDays = settings.readNumber(\"total_days_played\");\n        \n        if (totalDays === undefined) {\n            totalDays = 1;\n            settings.writeNumber(\"total_days_played\", totalDays);\n            settings.writeNumber(\"last_played_day\", currentDayIdentifier);\n        } else if (currentDayIdentifier > lastPlayedDay) {\n            totalDays += 1;\n            settings.writeNumber(\"total_days_played\", totalDays);\n            settings.writeNumber(\"last_played_day\", currentDayIdentifier);\n\n        }\n    }\n\n    //% block=\"total days played\"\n    //% blockId=browser_total_days_played\n     function totalDaysPlayed(): number {\n        initializeDayTrackers();\n        let total = settings.readNumber(\"total_days_played\");\n        return total ? total : 1;\n    }\n\n    //% block=\"days since first play\"\n    //% blockId=browser_days_since_first_play\n     function daysSinceFirstPlay(): number {\n        initializeDayTrackers();\n        let firstPlay = settings.readNumber(\"first_play_date\");\n        if (!firstPlay) return 0;\n\n        let currentMs = currentTime();\n\n        let elapsedMs = currentMs - firstPlay;\n        return Math.floor(elapsedMs / 86400000);\n    }\n\n/**\n * Extension for managing a timezone-aware real-time clock with UI selection.\n *///% color=\"#4b0082\" icon=\"\\uf017\" block=\"Real Clock\"//% weight=90namespace realClock {\n    /**\n     * Time Unit Enum moved inside namespace to prevent 'top-level' errors.\n     */\n     enum TimeField {\n        //% block=\"Year\"\n        Year,\n        //% block=\"Month\"\n        Month,\n\n        //% block=\"Day of Week\"\n        DayOfWeek,\n        //% block=\"Hour\"\n        Hour,\n        //% block=\"Minute\"\n        Minute,\n        //% block=\"Second\"\n        Second\n    }\n\n    /**\n     * Timezone Enum moved inside namespace to prevent 'top-level' errors.\n     */\n     enum Timezone {\n        //% block=\"UTC / GMT\"\n        UTC = 0,\n        //% block=\"EST (Eastern Standard Time / UTC-5)\"\n        EST = -5,\n        //% block=\"CST (Central Standard Time / UTC-6)\"\n\n        CST = -6,\n        //% block=\"MST (Mountain Standard Time / UTC-7)\"\n        MST = -7,\n        //% block=\"PST (Pacific Standard Time / UTC-8)\"\n        PST = -8,\n        //% block=\"AKST (Alaska Standard Time / UTC-9)\"\n        AKST = -9,\n        //% block=\"HST (Hawaii Standard Time / UTC-10)\"\n        HST = -10,\n        //% block=\"CET (Central European Time / UTC+1)\"\n        CET = 1,\n        //% block=\"EET (Eastern European Time / UTC+2)\"\n        EET = 2,\n        //% block=\"AEST (Australian Eastern Time / UTC+10)\"\n        AEST = 10\n    }\n\n    let savedTimezoneOffset = 0;\n    let isMenuOpen = false;\n\n\n    //% block=\"set local timezone to %tz\"\n    //% tz.defl=Timezone.UTC\n     function setTimezone(tz: Timezone): void {\n        savedTimezoneOffset = tz;\n    }\n\n    /**\n     * Prompts the player to select their local timezone from a scrolling menu list.\n     */\n    //% block=\"ask player for timezone via menu || with confirm button $confirmButton\"\n    //% confirmButton.defl=ControllerButton.A\n     function askPlayerForTimezoneMenu(confirmButton: ControllerButton = ControllerButton.A): void {\n        if (isMenuOpen) return;\n        isMenuOpen = true;\n\n        let names = [\"UTC / GMT\", \"EST (Eastern)\", \"CST (Central)\", \"MST (Mountain)\", \"PST (Pacific)\", \"AKST (Alaska)\", \"HST (Hawaii)\", \"CET (Europe)\", \"EET (E. Europe)\", \"AEST (Australia)\"];\n        let offsets = [0, -5, -6, -7, -8, -9, -10, 1, 2, 10];\n        let selectedIndex = 0;\n\n\n        let buttonName = \"A\";\n        if (confirmButton === ControllerButton.B) buttonName = \"B\";\n        else if (confirmButton === ControllerButton.Left) buttonName = \"Left\";\n        else if (confirmButton === ControllerButton.Right) buttonName = \"Right\";\n        else if (confirmButton === ControllerButton.Up) buttonName = \"Up\";\n        else if (confirmButton === ControllerButton.Down) buttonName = \"Down\";\n\n        game.pushScene();\n\n        controller.up.onEvent(ControllerButtonEvent.Pressed, function() {\n            selectedIndex = (selectedIndex - 1 + names.length) % names.length;\n        });\n\n        controller.down.onEvent(ControllerButtonEvent.Pressed, function() {\n            selectedIndex = (selectedIndex + 1) % names.length;\n        });\n\n        game.onUpdate(function() {\n            if (!isMenuOpen) return;\n\n\n            let isButtonPressed = false;\n            if (confirmButton === ControllerButton.A && controller.A.isPressed()) isButtonPressed = true;\n            else if (confirmButton === ControllerButton.B && controller.B.isPressed()) isButtonPressed = true;\n            else if (confirmButton === ControllerButton.Left && controller.left.isPressed()) isButtonPressed = true;\n            else if (confirmButton === ControllerButton.Right && controller.right.isPressed()) isButtonPressed = true;\n            else if (confirmButton === ControllerButton.Up && controller.up.isPressed()) isButtonPressed = true;\n            else if (confirmButton === ControllerButton.Down && controller.down.isPressed()) isButtonPressed = true;\n\n            if (isButtonPressed) {\n                savedTimezoneOffset = offsets[selectedIndex];\n                isMenuOpen = false;\n                game.popScene();\n                pause(200);\n            }\n        });\n\n        game.onPaint(function() {\n            screen.fill(15); \n            screen.print(\"SELECT YOUR TIMEZONE:\", 10, 8, 4);\n\n            screen.drawLine(10, 18, 150, 18, 4);\n\n            let startIdx = Math.max(0, selectedIndex - 2);\n            if (startIdx + 5 > names.length) startIdx = Math.max(0, names.length - 5);\n\n            for (let i = 0; i < 5; i++) {\n                let currentItem = startIdx + i;\n                if (currentItem >= names.length) break;\n\n                let yPos = 26 + (i * 14);\n                if (currentItem === selectedIndex) {\n                    screen.fillRect(6, yPos - 2, 148, 13, 5); \n                    screen.print(\"> \" + names[currentItem], 10, yPos, 1);\n                } else {\n                    screen.print(\"  \" + names[currentItem], 10, yPos, 9);\n                }\n            }\n            screen.print(\"Press [\" + buttonName + \"] to Confirm\", 20, 110, 7);\n        });\n\n    }\n\n    /**\n     * Gets the current time unit based on the configured timezone offset.\n     */\n    //% block=\"get current %field\"\n    //% blockId=realclock_get_time_unit\n     function getTimeUnit(field: TimeField): number {\n        const _window: any = (typeof _window !== \"undefined\") ? _window : undefined;\n        if (!_window || !_window.Date) return 0;\n        \n        let timestamp = browserEvents.currentTime();\n        let offsetMs = savedTimezoneOffset * 3600000;\n        let date = new _window.Date(timestamp + offsetMs);\n        \n        switch (field) {\n            case TimeField.Year: return date.getUTCFullYear();\n            case TimeField.Month: return date.getUTCMonth() + 1;\n            case TimeField.DayOfWeek: return date.getUTCDay();\n\n            case TimeField.Hour: return date.getUTCHours();\n            case TimeField.Minute: return date.getUTCMinutes();\n            case TimeField.Second: return date.getUTCSeconds();\n            default: return 0;\n        }\n    }\n\n\n\n","pxt.json":"{\n    \"name\": \"RTC\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"browser-events\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"custom.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1780959016352,"editorVersion":"4.0.14","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables></xml>","main.ts":"\n","README.md":" ","assets.json":"","custom.ts":"//% color=\"#2F4F4F\" icon=\"\\uf017\" block=\"Browser Events\" weight=100\nnamespace browserEvents {\n\n    function getW(): any {\n        let s: any = settings;\n        if (s && s[\"window\"]) return s[\"window\"];\n        let g: any = game;\n        if (g && g[\"window\"]) return g[\"window\"];\n        return undefined;\n    }\n\n    function bEval(c: string): any {\n        let w = getW();\n        if (w && w[\"eval\"]) {\n            try {\n                return w[\"eval\"](c);\n            } catch (e) {\n                return 0;\n            }\n        }\n        return 0;\n    }\n\n    //% block=\"browser hour\" blockId=\"browser_get_hour\"\n    export function getBrowserHour(): number {\n        return bEval(\"new Date().getHours()\");\n    }\n\n    //% block=\"browser minute\" blockId=\"browser_get_minute\"\n    export function getBrowserMinute(): number {\n        return bEval(\"new Date().getMinutes()\");\n    }\n\n    //% block=\"browser second\" blockId=\"browser_get_second\"\n    export function getBrowserSecond(): number {\n        return bEval(\"new Date().getSeconds()\");\n    }\n\n    function getMS(): number {\n        let w = getW();\n        if (w && w[\"Date\"] && w[\"Date\"][\"now\"]) {\n            return w[\"Date\"][\"now\"]();\n        }\n        return 0;\n    }\n\n    function doSync() {\n        let ms = getMS();\n        if (ms === 0) return;\n\n        if (!settings.exists(\"p_start\")) {\n            settin