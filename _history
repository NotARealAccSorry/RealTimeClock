sPressed()) check = true;\n            if (check) {\n                savedTz = offsets[idx];\n                menuOn = false;\n                game.popScene();\n            }\n        });\n        game.onPaint(function () {\n            screen.fill(15);\n            screen.print(\"SELECT TIMEZONE\", 10, 5, 4);\n            let start = Math.max(0, Math.min(idx - 2, names.length - 5));\n            for (let k = 0; k < 5; k++) {\n                let cur = start + k;\n                let y = 25 + (k * 15);\n                if (cur === idx) {\n                    screen.fillRect(5, y - 2, 150, 12, 4);\n                    screen.print(\"> \" + names[cur], 10, y, 5);\n                } else {\n                    screen.print(\"  \" + names[cur], 10, y, 1);\n                }\n            }\n        });\n    }\n}\n","pxt.json":"{\n    \"name\": \"RTC\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"browser-events\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"custom.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1780959604334}