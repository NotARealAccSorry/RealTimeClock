rowserEvents.KeyEvent.Pressed, handleConfirm); break;\n        }\n\n        game.onShade(function() {\n            if (!isMenuOpen) return;\n            screen.fill(11); \n            screen.print(\"SELECT YOUR TIMEZONE\", 10, 10, 1);\nUse code with caution.screen.print(\"Press [\" + keyLabel + \"] to Confirm\", 10, 110, 5);for (let i = 0; i < names.length; i++) {let y = 30 + (i * 8);if (i === selectedIndex) {screen.print(\"> \" + names[i], 15, y, 7);} else {screen.print(\"  \" + names[i], 15, y, 9);}}});}//% block=\"get current local %unit\"//% unit.defl=TimeField.Hourexport function getTimeUnit(unit: TimeField): number {let rawTimestamp = browserEvents.getCurrentTime();let localTimestamp = rawTimestamp + (savedTimezoneOffset * 3600);let totalSeconds = Math.max(0, localTimestamp);let currentSecond = totalSeconds % 60;let totalMinutes = Math.floor(totalSeconds / 60);let currentMinute = totalMinutes % 60;let totalHours = Math.floor(totalMinutes / 60);let currentHour = totalHours % 24;if (unit === TimeField.Second) return currentSecond;if (unit === TimeField.Minute) return currentMinute;if (unit === TimeField.Hour) return currentHour;if (unit === TimeField.DayOfWeek) {let totalDays = Math.floor(totalHours / 24);return (totalDays + 4) % 7;}let daysSinceEpoch = Math.floor(totalHours / 24);let approxYear = 1970 + Math.floor(daysSinceEpoch / 365.25);if (unit === TimeField.Year) return approxYear;if (unit === TimeField.Month) {let dayOfYear = Math.floor(daysSinceEpoch % 365.25);return Math.floor(dayOfYear / 30.4) + 1;}return 0;}","pxt.json":"{\n    \"name\": \"RTC\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"browser-events\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"custom.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1780896182430,"editorVersion":"4.0.14","text":{"main.blocks":"<xml xmlns=\"https://de