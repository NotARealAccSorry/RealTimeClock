);\n            screen.drawLine(10, 18, 150, 18, 4);\n\n            let startIdx = Math.max(0, selectedIndex - 2);\n            if (startIdx + 5 > names.length) startIdx = Math.max(0, names.length - 5);\n\n            for (let i = 0; i < 5; i++) {\n                let currentItem = startIdx + i;\n                if (currentItem >= names.length) break;\n\n                let yPos = 26 + (i * 14);\n                if (currentItem === selectedIndex) {\n                    screen.fillRect(6, yPos - 2, 148, 13, 5); \n                    screen.print(\"> \" + names[currentItem], 10, yPos, 1);\n                } else {\n                    screen.print(\"  \" + names[currentItem], 10, yPos, 9);\n                }\n            }\n            \n            screen.print(\"Press [\" + buttonName + \"] to Confirm\", 20, 105, 7);\n        });\n\n        while (isMenuOpen) {\n            pause(20);\n        }\n    }\n\n    /**\n     * Extracts a specific time unit as a number based on the saved timezone.\n     */\n    //% block=\"get current %field\"\n    export function getTimeUnit(field: TimeField): number {\n        let timestamp = browserEvents.currentTime();\n        \n        let totalSeconds = Math.floor(timestamp / 1000);\n        let totalMinutes = Math.floor(totalSeconds / 60);\n        let totalHours = Math.floor(totalMinutes / 60);\n        let totalDays = Math.floor(totalHours / 24);\n\n        let localHours24 = (totalHours + savedTimezoneOffset) % 24;\n        if (localHours24 < 0) localHours24 += 24;\n\n        if (field === TimeField.Second) return totalSeconds % 60;\n        if (field === TimeField.Minute) return totalMinutes % 60;\n        if (field === TimeField.Hour) return localHours24;\n\n        let adjustedDays = totalDays + Math.floor((totalHours + savedTimezoneOffset) / 24) - totalDays;\n        let dayCounter = totalDays + adjustedDays;\n\n        if (field === TimeField.DayOfWeek) {\n            return (dayCounter + 4) % 7;\n        }\n\n        let year = 1970;\n        while (true) {\n            let daysInYear = (year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0)) ? 366 : 365;\n            if (dayCounter >= daysInYear) {\n                dayCounter -= daysInYear;\n                year++;\n            } else {\n                break;\n            }\n        }\n        if (field === TimeField.Year) return year;\n\n        let isLeap = (year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0));\n        let daysInMonths = [31, isLeap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n        let month = 1;\n        for (let i = 0; i < 12; i++) {\n            if (dayCounter >= daysInMonths[i]) {\n                dayCounter -= daysInMonths[i];\n                month++;\n            } else {\n                break;\n            }\n        }\n        if (field === TimeField.Month) return month;\n\n        return 0;\n    }\n\n    //% block=\"current %field equals %value\"\n    export function isTimeFieldEqual(field: TimeField, value: number): boolean {\n        return getTimeUnit(field) === value;\n    }\n\n    //% block=\"is current time PM\"\n    export function isPM(): boolean {\n        return getTimeUnit(TimeField.Hour) >= 12;\n    }\n\n    //% block=\"get day of week name string\"\n    export function getDayOfWeekName(): string {\n        let dayNum = getTimeUnit(TimeField.DayOfWeek);\n        let days = [\"Sunday\", \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"];\n        return days[dayNum];\n    }\n\n    //% block=\"is night time\"\n    export function isNightTime(): boolean {\n        let hr = getTimeUnit(TimeField.Hour);\n        return (hr >= 19 || hr < 6);\n    }\n\n    //% block=\"is weekend\"\n    export function isWeekend(): boolean {\n        let dayNum = getTimeUnit(TimeField.DayOfWeek);\n        return (dayNum === 0 || dayNum === 6);\n    }\n\n    //% block=\"get formatted time string\"\n    export function getFormattedTime(): string {\n        let hour = getTimeUnit(TimeField.Hour);\n        let minute = getTimeUnit(TimeField.Minute);\n        let second = getTimeUnit(TimeField.Second);\n\n        let amPm = hour >= 12 ? \"PM\" : \"AM\";\n        let hours12 = hour % 12;\n        if (hours12 === 0) hours12 = 12;\n\n        let minuteString = minute < 10 ? \"0\" + minute : \"\" + minute;\n        let secondString = second < 10 ? \"0\" + second : \"\" + second;\n\n        return hours12 + \":\" + minuteString + \":\" + secondString + \" \" + amPm;\n    }\n}\n","pxt.json":"{\n    \"name\": \"RTC\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"browser-events\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"custom.ts\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1780925968860,"editorVersion":"4.0.14","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables></xml>","main.ts":"\n","README.md":" ","assets.json":"","custom.ts":"// Tell the MakeCode compiler that 'window' exists as a dynamic object\ndeclare const window: any;\n\n//% color=\"#2F4F4F\" icon=\"\\uf017\" block=\"Browser Analytics\"\nnamespace browserEvents {\n\n    /**\n     * Internal helper to track dates. This runs quietly when the game boots.\n     */\n    function initializeDayTrackers() {\n        let currentMs = 0;\n\n        // Safely check if window and Date exist using our declared variable\n        if (typeof window !== \"undefined\" && window.Date) {\n            currentMs = window.Date.now();\n        } else {\n            currentMs = control.millis();\n        }\n        \n        // 1. Handle \"Days Since First Play\"\n        if (!settings.exists(\"first_play_date\")) {\n            settings.writeNumber(\"first_play_date\", currentMs);\n        }\n\n        // 2. Handle \"Total Days Played\" (Unique calendar days)\n        let standardDayMs = 86400000; // 24 hours in milliseconds\n        let currentDayIdentifier = Math.floor(currentMs / standardDayMs);\n        \n        let lastPlayedDay = settings.readNumber(\"last_played_day\");\n        let totalDays = settings.readNumber(\"total_days_played\");\n        \n        if (totalDays === undefined) {\n            totalDays = 1;\n            settings.writeNumber(\"total_days_played\", totalDays);\n            settings.writeNumber(\"last_played_day\", currentDayIdentifier);\n        } else if (currentDayIdentifier > lastPlayedDay) {\n            totalDays += 1;\n            settings.writeNumber(\"total_days_played\", totalDays);\n            settings.writeNumber(\"last_played_day\", currentDayIdentifier);\n        }\n    }\n\n    /**\n     * Returns the total number of unique calendar days this player has opened your game.\n     */\n    //% block=\"total days played\"\n    //% blockId=browser_total_days_played\n    export function totalDaysPlayed(): number {\n        initializeDayTrackers();\n        let total = settings.readNumber(\"total_days_played\");\n        return total ? total : 1;\n    }\n\n    /**\n     * Returns how many days have elapsed since the user played the game for the first time.\n     */\n    //% block=\"days since first play\"\n    //% blockId=browser_days_since_first_play\n    export function daysSinceFirstPlay(): number {\n        initializeDayTrackers();\n        let firstPlay = settings.readNumber(\"first_play_date\");\n        if (!firstPlay) return 0;\n\n        let currentMs = 0;\n        if (typeof window !== \"undefined\" && window.Date) {\n            currentMs = window.Date.now();\n        } else {\n            currentMs = control.millis();\n        }\n\n        let elapsedMs = currentMs - firstPlay;\n        let elapsedDays = Math.floor(elapsedMs / 86400000);\n        return elapsedDays;\n    }\n}\n","pxt.json":"{\n    \"name\": \"RTC\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n  